# Shopify Storefront API (public token; safe for the browser but we keep it server side)
SHOPIFY_STORE_DOMAIN=shop.doctorbox.de
SHOPIFY_API_VERSION=2025-07
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Public site URL (used for canonical/hreflang/sitemap)
NEXT_PUBLIC_SITE_URL=

# Consent & analytics (values taken from the current shop)
NEXT_PUBLIC_IUBENDA_SITE_ID=
NEXT_PUBLIC_IUBENDA_POLICY_ID_DE=
NEXT_PUBLIC_IUBENDA_POLICY_ID_EN=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_KLAVIYO_COMPANY_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_ETRUSTED_ENABLED=
# Trusted Shops widget ID (data-etrusted-widget-id) – not readable from the old theme, add from eTrusted control centre
NEXT_PUBLIC_ETRUSTED_WIDGET_ID=
# Tracking IDs: defaults live in src/lib/tracking/config.ts; set these only to override them
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_REDDIT_PIXEL_ID=

# AI test advisor (Claude API). Without a key the chat shows a "coming soon" note.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
# Only needed when the API key is an organisation key without workspace scope
ANTHROPIC_WORKSPACE_ID=

# B2B inquiry form: delivered via Resend when set, otherwise logged on the server
RESEND_API_KEY=
B2B_INQUIRY_TO=heimtest@doctorbox.eu
B2B_INQUIRY_FROM=DoctorBox Shop <shop@doctorbox.de>

# Shopify-hosted domain for checkout and the UCP agent endpoints (proxied/redirected from this app)
SHOPIFY_ONLINE_STORE_DOMAIN=doctorbox-heimtests.myshopify.com

# Trusted Shops (eTrusted) API: product reviews on the product pages. Server only.
ETRUSTED_CLIENT_ID=
ETRUSTED_CLIENT_SECRET=
ETRUSTED_CHANNEL_ID=

# Klaviyo list for newsletter sign-ups (server side; double opt-in is set on the list)
KLAVIYO_LIST_ID=

# Strike-through prices (Shopify compare-at) are hidden by default. Set to true only once the lowest price of the last 30 days is documented (PAngV).
NEXT_PUBLIC_SHOW_COMPARE_PRICES=false
