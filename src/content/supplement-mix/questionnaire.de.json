        },
        {
          "id": "amountStatus",
          "type": "single",
          "label": "Kennst du die tägliche Menge?",
          "required": true,
          "options": [
            {
              "value": "known",
              "label": "Ja, Menge ist bekannt"
            },
            {
              "value": "unknown",
              "label": "Ich kenne die Menge nicht"
            },
            {
              "value": "unit_unsupported",
              "label": "Das Etikett nennt eine andere Einheit"
            }
          ]
        },
        {
          "id": "dailyAmount",
          "type": "decimal_string",
          "label": "Menge pro Tag",
          "requiredWhen": {
            "operator": "eq",
            "field": "amountStatus",
            "value": "known"
          },
          "pattern": "^(?:0|[1-9][0-9]*)(?:[.,][0-9]+)?$",
          "mustBeGreaterThan": "0",
          "notFreeText": true
        },
        {
          "id": "unit",
          "type": "single",
          "label": "Einheit",
          "requiredWhen": {
            "operator": "eq",
            "field": "amountStatus",
            "value": "known"
          },
          "options": [
            {
              "value": "mg",
              "label": "mg"
            },
            {
              "value": "ug",
              "label": "µg"
            }
