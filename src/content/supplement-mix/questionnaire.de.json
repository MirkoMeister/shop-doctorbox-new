    "existingIntakes": "Normalize only known amounts. Resolve canonical nutrient identity through a versioned mapping; do not equate different nutrient forms automatically.",
    "sumKnownSupplementIntakesOnlyWithValidatedRule": true,
    "noClaimOfCompleteDietaryOrDailyIntake": true
  },
  "branchAndRiskRuleSemantics": {
    "scope": "Declarative navigation, profile facts and catalog exclusions. No ingredient selection or dosage computation is defined here.",
    "operators": {
      "eq": "Exact field-value comparison.",
      "in": "Scalar field equals one of values.",
      "includes": "Array field contains value.",
      "includes_any": "Array field intersects values.",
      "is_missing": "Field has no answer.",
      "is_empty": "Field absent or array empty.",
      "all": "Every nested condition is true.",
      "any": "At least one nested condition is true.",
      "any_record": "At least one array record matches recordWhen, whose field references are local to that record.",
      "rule_binding_exists": "The enabled versioned rulebook explicitly declares the binding key."
    },
    "riskFlagMeaning": "Fact or missing-information flag for configured product/profile coverage rules; not a diagnosis, blanket sales prohibition or instruction for manual clinical approval.",
    "effectRecomputation": "Rebuild derived flags and product exclusions from current answers after each change; do not accumulate stale flags.",
    "catalogTags": "Tags must be confirmed from the actual supplier/catalog data. Missing tags are unknown, not proof of compatibility.",
    "productPreferencePrecedence": "Explicit product_preference controls product exclusions. diet_pattern is separate and must not silently override the explicit choice."
  },
  "branchAndRiskRules": [
    {
      "id": "consent_declined",
      "when": {
        "operator": "eq",
        "field": "health_data_consent",
        "value": "decline"
      },
      "effects": [
        {
          "type": "clear_answers",
          "except": [
            "health_data_consent"
          ]
        },
        {
          "type": "navigate",
          "target": "self_configurator"
        }
      ]
    },
    {
      "id": "consent_accepted",
      "when": {
        "operator": "eq",
        "field": "health_data_consent",
        "value": "accept"
      },
      "effects": [
        {
          "type": "navigate",
          "target": "age_band"
        }
      ]
    },
    {
      "id": "minor_profile",
      "when": {
        "operator": "eq",
        "field": "age_band",
        "value": "under_18"
      },
      "effects": [
        {
          "type": "add_risk_flag",
          "code": "profile_under_18"
        }
      ]
    },
    {
      "id": "age_unknown",
      "when": {
        "operator": "any",
        "conditions": [
          {
            "operator": "eq",
            "field": "age_band",
            "value": "prefer_not"
          },
          {
            "operator": "is_missing",
            "field": "age_band"
          }
        ]
      },
      "effects": [
        {
          "type": "add_risk_flag",
          "code": "age_unknown"
        }
      ]
    },
    {
      "id": "existing_supplements_yes",
      "when": {
        "operator": "eq",
        "field": "existing_supplements",
        "value": "yes"
      },
      "effects": [
        {
          "type": "add_risk_flag",
          "code": "current_supplements_reported"
        },
        {
          "type": "show_if_rule_bound",
          "questionId": "current_intakes",
          "bindingKey": "eligibility.current_supplement_intake"
        }
      ]
    },
    {
      "id": "existing_supplements_no",
      "when": {
        "operator": "eq",
        "field": "existing_supplements",
        "value": "no"
      },
      "effects": [
        {
          "type": "clear_answer",
          "questionId": "current_intakes"
        }
      ]
    },
    {
      "id": "existing_supplements_unknown",
      "when": {
        "operator": "in",
        "field": "existing_supplements",
        "values": [
          "unknown",
          "prefer_not"
        ]
      },
      "effects": [
        {
          "type": "add_risk_flag",
          "code": "current_supplement_intake_unknown"
        },
        {
          "type": "clear_answer",
          "questionId": "current_intakes"
        }
      ]
    },
    {
      "id": "current_intakes_missing",
      "when": {
        "operator": "all",
        "conditions": [
          {
            "operator": "eq",
            "field": "existing_supplements",
            "value": "yes"
          },
          {
            "operator": "is_empty",
            "field": "current_intakes"
          }
        ]
      },
      "effects": [
        {
          "type": "add_risk_flag",
          "code": "supplemental_intake_incomplete"
        }
      ]
    },
    {
      "id": "current_intakes_incomplete",
      "when": {
        "operator": "any_record",
        "field": "current_intakes",
        "recordWhen": {
          "operator": "any",
          "conditions": [
            {
              "operator": "in",
              "field": "amountStatus",
              "values": [
                "unknown",
                "unit_unsupported"
              ]
            },
            {
              "operator": "eq",
              "field": "ingredientKey",
              "value": "not_listed"
            }
          ]
        }
      },
      "effects": [
        {
          "type": "add_risk_flag",
          "code": "supplemental_intake_incomplete"
        }
      ]
    },
    {
      "id": "medication_reported",
      "when": {
        "operator": "eq",
        "field": "regular_medication",
        "value": "yes"
      },
      "effects": [
        {
          "type": "add_risk_flag",
          "code": "regular_medication_reported"
        }
      ]
    },
    {
      "id": "medication_unknown",
      "when": {
        "operator": "any",
        "conditions": [
          {
            "operator": "in",
            "field": "regular_medication",
            "values": [
              "unknown",
              "prefer_not"
            ]
          },
          {
            "operator": "is_missing",
            "field": "regular_medication"
          }
        ]
      },
      "effects": [
        {
          "type": "add_risk_flag",
          "code": "medication_information_unknown"
        }
      ]
    },
    {
      "id": "conditions_reported",
      "when": {
        "operator": "includes_any",
        "field": "relevant_conditions",
        "values": [
          "kidney",
          "liver",
          "thyroid",
          "iron_metabolism",
          "other"
        ]
      },
      "effects": [
        {
          "type": "add_risk_flag",
          "code": "condition_reported"
        },
        {
          "type": "copy_selected_to_profile_facts",
          "source": "relevant_conditions",
          "exclude": [
            "none_known",
            "prefer_not"
          ]
        }
      ]
    },
    {
      "id": "conditions_unknown",
      "when": {
        "operator": "includes",
        "field": "relevant_conditions",
        "value": "prefer_not"
      },
      "effects": [
        {
          "type": "add_risk_flag",
          "code": "condition_information_unknown"
        }
      ]
    },
    {
      "id": "pregnancy_reported",
      "when": {
        "operator": "eq",
        "field": "pregnancy_status",
        "value": "pregnant"
      },
      "effects": [
        {
          "type": "add_risk_flag",
          "code": "pregnancy_reported"
        }
      ]
    },
    {
      "id": "breastfeeding_reported",
      "when": {
        "operator": "eq",
        "field": "pregnancy_status",
        "value": "breastfeeding"
      },
      "effects": [
        {
          "type": "add_risk_flag",
          "code": "breastfeeding_reported"
        }
      ]
    },
    {
      "id": "pregnancy_planning_reported",
      "when": {
        "operator": "eq",
        "field": "pregnancy_status",
        "value": "planning"
      },
      "effects": [
        {
          "type": "add_risk_flag",
          "code": "pregnancy_planning_reported"
        }
      ]
    },
    {
      "id": "pregnancy_unknown",
      "when": {
        "operator": "in",
        "field": "pregnancy_status",
        "values": [
          "unknown",
          "prefer_not"
        ]
      },
      "effects": [
        {
          "type": "add_risk_flag",
          "code": "pregnancy_information_unknown"
        }
      ]
    },
    {
      "id": "fish_allergy",
      "when": {
        "operator": "includes",
        "field": "allergies",
        "value": "fish"
      },
      "effects": [
        {
          "type": "add_risk_flag",
          "code": "fish_allergy_reported"
        },
        {
          "type": "exclude_product_by_confirmed_catalog_tag",
          "tag": "contains_fish",
          "reasonCode": "fish_allergy",
          "knownEffect": "Exclude Riise fish-oil Omega-3 softgels."
        }
      ]
    },
    {
      "id": "soy_allergy",
      "when": {
        "operator": "includes",
        "field": "allergies",
        "value": "soy"
      },
      "effects": [
        {
          "type": "add_risk_flag",
          "code": "soy_allergy_reported"
        },
        {
          "type": "exclude_product_by_confirmed_catalog_tag",
          "tag": "contains_soy",
          "reasonCode": "soy_allergy",
          "unknownCatalogBehavior": "allergen_coverage_incomplete"
        }
      ]
    },
    {
      "id": "allergen_coverage_unknown",
      "when": {
        "operator": "includes_any",
        "field": "allergies",
        "values": [
          "other",
          "unknown",
          "prefer_not"
        ]
      },
      "effects": [
        {
          "type": "add_risk_flag",
          "code": "allergen_coverage_incomplete"
        }
      ]
    },
    {
      "id": "vegetarian_product_selection",
      "when": {
        "operator": "eq",
        "field": "product_preference",
        "value": "vegetarian"
      },
      "effects": [
        {
          "type": "exclude_product_by_confirmed_catalog_tag",
          "tag": "non_vegetarian",
          "reasonCode": "vegetarian_preference"
        },
        {
          "type": "exclude_product_by_confirmed_catalog_tag",
          "tag": "contains_fish",
          "reasonCode": "vegetarian_preference"
        }
      ]
    },
    {
      "id": "vegan_product_selection",
      "when": {
        "operator": "eq",
        "field": "product_preference",
        "value": "vegan"
      },
      "effects": [
        {
          "type": "exclude_product_by_confirmed_catalog_tag",
          "tag": "non_vegan",
          "reasonCode": "vegan_preference"
        },
        {
          "type": "exclude_product_by_confirmed_catalog_tag",
          "tag": "contains_fish",
          "reasonCode": "vegan_preference"
        }
      ]
    }
  ],
  "recommendationEngineContract": {
    "requiredConfiguration": [
      "questionnaireVersion",
      "catalogVersion",
      "ruleVersion",
      "explicit_question_bindings",
      "profile_coverage_rules",
      "ingredient_selection_rules",
      "quantity_rules",
      "product_target_group_rules",
      "allergen_rules",
      "nutrient_form_mapping",
      "combination_rules",
      "technical_validation_rules"
    ],
    "realRecommendationAllowedOnlyWithCompleteApplicableRules": true,
    "allowedStatuses": [
      "ready",
      "rule_configuration_missing",
      "not_supported",
      "insufficient_data"
    ],
    "missingRulesStatus": "rule_configuration_missing",
    "unsupportedProfileStatus": "not_supported",
    "missingRequiredRuleInputsStatus": "insufficient_data",
    "riskFlagsWithoutExplicitCoverage": "Do not infer clearance or a dose. Return not_supported or insufficient_data according to the configured coverage rule.",
    "noLLMComputedDose": true,
    "noInventedScores": true,
    "noInferredRiiseAlgorithm": true,
    "noMandatoryManualClinicalOrderApproval": true,
    "failureRoute": "Offer self-configuration only for products whose mandatory eligibility and compatibility checks can be satisfied; otherwise explain the concrete unavailable option.",
    "failureUi": {
      "rule_configuration_missing": "Der Rezepturvorschlag ist noch nicht verfügbar.",
      "not_supported": "Für deine Angaben können wir aktuell keinen Rezepturvorschlag berechnen.",
      "insufficient_data": "Für einen Rezepturvorschlag fehlen noch Angaben."
    },
    "readyResponseFields": [
      "status",
      "mode",
      "questionnaireVersion",
      "ruleVersion",
      "productRuleVersion",
      "catalogVersion",
      "ingredients[].ingredientId",
      "ingredients[].nutrientKey",
      "ingredients[].quantityMg",
      "ingredients[].displayAmount",
      "ingredients[].displayUnit",
      "ingredients[].reasonCodes",
      "omega3Months",
      "reasonCodes",
      "unresolvedFlags",
      "excludedProductIds",
      "pricingStatus"
    ],
    "uiReasonCopy": "Use only approved factual reason text from the matched rule. Do not infer a deficiency or treatment benefit.",
    "afterManualChanges": "Re-run applicable catalog, dose-step, combination, profile-coverage, target-group and allergen checks on the final formula. A questionnaire recommendation is not a permanent clearance.",
    "paymentHandling": "Technical final-formula validation and a locked formula reference belong before checkout; a verified paid Shopify order is revalidated before the idempotent Riise submission. No frontend payment redirect triggers production.",
    "allowedModes": [
      "demo",
      "live"
    ],
    "noIngredientsWhenUnavailable": true,
    "nonReadyIngredients": [],
    "nonReadyOmega3Months": null,
    "pricingStatusValues": [
      "unpriced",
      "not_configured"
    ]
  },
  "acceptanceChecks": [
    {
      "id": "consent_first",
      "given": "No consent answer",
      "expect": "No health question is rendered and no health answer is collected."
    },
    {
      "id": "consent_declined",
      "given": "health_data_consent=decline",
      "expect": "Route to self_configurator; clear questionnaire answers; do not skip mandatory product rules."
    },
    {
      "id": "optional_unbound",
      "given": "No rule binding for sleep_duration",
      "expect": "Do not render, collect, store or evaluate sleep_duration."
    },
    {
      "id": "unknown_is_unknown",
      "given": "regular_medication=prefer_not",
      "expect": "Set medication_information_unknown; never transform the answer into no."
    },
    {
      "id": "fish_allergy",
      "given": "allergies includes fish",
      "expect": "Exclude confirmed contains_fish products, including Riise fish-oil Omega-3 softgels."
    },
    {
      "id": "vegan_preference",
      "given": "product_preference=vegan",
      "expect": "Exclude confirmed non_vegan products and fish-oil Omega-3; do not invent an algae substitute."
    },
    {
      "id": "unknown_intake",
      "given": "A current_intakes row has amountStatus=unknown",
      "expect": "Set supplemental_intake_incomplete; do not invent an amount."
    },
    {
      "id": "microgram_conversion",
      "given": "dailyAmount=25, unit=ug",
      "expect": "Use exact decimal quantityMg=0.025."
    },
    {
      "id": "unsupported_unit",
      "given": "A product label uses an unsupported unit",
      "expect": "Accept only the structured unit_unsupported answer; do not infer a conversion."
    },
    {
      "id": "missing_rulebook",
      "given": "No applicable versioned quantity rules",
      "expect": "Return rule_configuration_missing or a clearly marked fictional demo; never create a real dosage."
    },
    {
      "id": "no_forced_clinical_queue",
      "given": "A profile is outside supported rule coverage",
      "expect": "Return not_supported with the concrete reason; do not invent a compulsory physician approval queue."
    },
    {
      "id": "change_parent_answer",
      "given": "existing_supplements changes from yes to no",
      "expect": "Clear current_intakes and remove flags derived from the cleared rows."
    },
    {
      "id": "guest_path",
      "given": "No DoctorBox login",
      "expect": "The questionnaire, self-configurator and existing Shopify cart are usable as a guest."
    },
    {
      "id": "minimal_shopify_data",
      "given": "Add the final mix to the existing cart",
      "expect": "No questionnaire answers or health risk flags are attached to Shopify; only the agreed transaction formula/reference and versions."
    }
  ],
  "apiAnswerShape": {
    "path": "POST /api/supplements/recommendation",
    "consentField": "consent",
    "answersField": "answers",
    "consentQuestionNotIncludedInAnswers": true,
    "knownAnswerKeyCount": 17,
    "unknownAnswerKeys": "reject",
    "canonicalDoseUnit": "mg",
    "acceptedCurrentIntakeUnits": [
      "mg",
      "ug"
    ]
  }
}
