    "persistAnswers": false,
    "storage": "memory_only",
    "noDataTransfers": [
      "shopify",
      "riise",
      "analytics",
      "model_context",
      "url",
      "browser_persistent_storage"
    ],
    "demoSuggestionLabel": "Beispielmix – keine persönliche Dosierungsempfehlung"
  },
  "consentImplementation": {
