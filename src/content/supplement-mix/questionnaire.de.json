    "optionalQuestionPolicy": "Render and use optional fields only when a versioned active rule explicitly declares that input binding. Otherwise omit them entirely.",
    "lifestyleFieldsAreNotDosageRules": true,
    "requiredQuestions": "Required inside the enabled questionnaire path; no forced completion when choosing self-configuration.",
    "unknownValues": [
      "unknown",
      "prefer_not",
      "variable",
      "other",
      "not_listed",
      "unit_unsupported"
    ],
    "missingOrUnknownNeverMeans": "no",
    "exclusiveMultiSelectOptions": "An exclusive option clears all other options; selecting another option clears an exclusive option.",
